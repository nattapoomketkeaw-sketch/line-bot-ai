LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
GEMINI_API_KEY=
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?output=csv
# optional but recommended: remembers each customer's conversation (Upstash Redis via Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# optional: your own LINE userId to receive a notification when a customer is handed off to you (send /myid to the bot to get it)
OWNER_LINE_USER_ID=
# optional: true = answer everyone, including friends who added the account before the bot went live (default: only new followers)
BOT_ALLOW_ALL=false

# --- Meta (Facebook Messenger + Instagram DM), api/meta.js ---
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
# optional but recommended: your Meta app id (helps tell the bot's own messages from the owner's)
META_APP_ID=
# optional: true = answer everyone, including existing chats (use for testing)
META_ALLOW_ALL=false
